{
  "id": "wordpress-user-enum",
  "info": {"name": "WordPress REST user enumeration", "severity": "low"},
  "requests": [{
    "method": "GET",
    "path": ["/wp-json/wp/v2/users", "/?rest_route=/wp/v2/users"],
    "matchers-condition": "and",
    "matchers": [
      {"type": "status", "status": [200]},
      {"type": "regex", "part": "body", "regex": ["\"slug\"\\s*:", "\"id\"\\s*:\\s*\\d+"], "condition": "and"}
    ]
  }]
}
